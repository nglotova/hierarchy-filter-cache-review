root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Kotlin sources match the indentation of the provided starter code;
# Gradle scripts keep the usual 4 spaces.
[*.kt]
indent_style = space
indent_size = 2

[*.kts]
indent_style = space
indent_size = 4
